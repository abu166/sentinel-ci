# Local portfolio defaults live in Compose. For an exposed deployment, disable
# demo login and replace every secret with independently generated values.
SENTINEL_DEMO_MODE=false
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
INTERNAL_TOKEN=
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
# Optional remote publication adapters; otherwise publication uses real local Git.
GITHUB_TOKEN=
GITLAB_TOKEN=
GITLAB_HOST=gitlab.com
LLM_API_KEY=

# Outside Compose, optional OTLP HTTP trace destination (Compose supplies Jaeger).
OTEL_EXPORTER_OTLP_ENDPOINT=
# Set a distinct service name in each service environment.
# HEALER_CANDIDATE_CONCURRENCY=3 (healer process-wide sandbox limit)
